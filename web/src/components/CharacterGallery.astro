---
import CharacterCard from "./CharacterCard.astro";
import CharacterDialog from "./CharacterDialog.astro";
import type { GalleryCharacter } from "../lib/characters";

export interface CharacterFilter {
  key: string;
  label: string;
  allLabel: string;
  options: Array<{ value: string; label?: string }>;
}

interface Props {
  id: string;
  characters: GalleryCharacter[];
  filters: CharacterFilter[];
  compassFilters?: CharacterFilter[];
  searchPlaceholder: string;
}

const { id, characters, filters, compassFilters = [], searchPlaceholder } = Astro.props;
const compassIcons: Record<string, string> = { care: "◎", method: "⚖", change: "↻" };
---

<div class="character-gallery" data-character-gallery id={id}>
  <form class="character-filters" aria-label="Фильтры персонажей">
    {filters.map((filter) => (
      <label>
        <span>{filter.label}</span>
        <span class="custom-select">
          <select data-character-filter={filter.key}>
            <option value="">{filter.allLabel}</option>
            {filter.options.map((option) => <option value={option.value}>{option.label ?? option.value}</option>)}
          </select>
        </span>
      </label>
    ))}
    {
      compassFilters.length > 0 && (
        <div class="compass-filter" data-compass-filter>
          <button type="button" class="compass-filter__toggle" data-compass-toggle aria-expanded="false">
            <span aria-hidden="true">◈</span>
            Куб выбора
          </button>
          <div class="compass-filter__panel" data-compass-panel hidden>
            <p>Выберите конкретную точку для каждой оси или оставьте ось без ограничения.</p>
            <div class="compass-filter__sliders">
            {compassFilters.map((filter) => {
              const options = [{ value: "", label: "Все" }, ...filter.options.map((option) => ({ value: option.value, label: option.label ?? option.value }))];
              return (
                <label>
                  <span><i class="compass-filter__axis-icon" aria-hidden="true">{compassIcons[filter.key] ?? "◈"}</i>{filter.label}</span>
                  <div class="compass-picker" data-character-picker={filter.key} role="group" aria-label={filter.label}>
                    {options.map((option) => (
                      <button type="button" data-picker-value={option.value} aria-pressed={option.value ? "false" : "true"}>
                        <i aria-hidden="true"></i>{option.label}
                      </button>
                    ))}
                  </div>
                </label>
              );
            })}
            </div>
          </div>
        </div>
      )
    }
    <label class="character-search">
      <span>Поиск</span>
      <input data-character-search type="search" placeholder={searchPlaceholder} />
    </label>
    <output data-character-count>Показано: {characters.length}</output>
  </form>

  <section class="character-grid">
    {characters.map((character) => <CharacterCard character={character} />)}
  </section>

  {characters.map((character) => <CharacterDialog character={character} />)}

  <dialog class="character-image-dialog" data-character-image-dialog aria-label="Портрет в полном размере">
    <button type="button" class="character-image-dialog__close" data-character-image-close aria-label="Закрыть портрет">×</button>
    <img data-character-image-element alt="" />
  </dialog>
</div>

<script>
  import "../scripts/character-gallery";
</script>
