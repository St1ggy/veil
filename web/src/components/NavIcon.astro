---
import BookMarked from '@lucide/astro/icons/book-marked'
import Compass from '@lucide/astro/icons/compass'
import Dices from '@lucide/astro/icons/dices'
import House from '@lucide/astro/icons/house'
import Languages from '@lucide/astro/icons/languages'
import Swords from '@lucide/astro/icons/swords'
import Search from '@lucide/astro/icons/search'

interface Properties {
  name: 'home' | 'glossary' | 'about' | 'system' | 'game' | 'language' | 'search'
  size?: number
  class?: string
}

const { name, size = 16, class: className } = Astro.props

const icons = {
  home: House,
  glossary: BookMarked,
  about: Compass,
  system: Dices,
  game: Swords,
  language: Languages,
  search: Search,
} as const

const Icon = icons[name]
---

<Icon class:list={['ui-icon', className]} size={size} stroke-width={1.7} aria-hidden="true" />
