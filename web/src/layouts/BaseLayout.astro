---
import BrandMark from "../components/BrandMark.astro";
import CategoryIcon from "../components/CategoryIcon.astro";
import NavIcon from "../components/NavIcon.astro";
import { categories } from "../i18n/categories";
import { languages, t, type Lang } from "../i18n/ui";
import {
  aboutHref,
  categoryHref,
  glossaryHref,
  langHome,
  withBase,
} from "../lib/wiki";

interface Props {
  lang: Lang;
  title: string;
  description?: string;
  pathAfterLang?: string;
  activeCategory?: string;
  activeNav?: "home" | "glossary" | "about";
}

const {
  lang,
  title,
  description,
  pathAfterLang = "",
  activeCategory,
  activeNav,
} = Astro.props;
const other: Lang = lang === "ru" ? "en" : "ru";
const otherHref = withBase(
  pathAfterLang ? `${other}/${pathAfterLang.replace(/^\/+/, "")}` : other,
);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · {t(lang, "brand")}</title>
    {description && <meta name="description" content={description} />}
    <link rel="stylesheet" href={withBase("styles/global.css")} />
  </head>
  <body>
    <div class="shell">
      <aside class="sidebar">
        <a class="brand" href={langHome(lang)}>
          <BrandMark />
          <span class="brand-text">
            <strong>{t(lang, "brand")}</strong>
            <small>{t(lang, "tagline")}</small>
          </span>
        </a>

        <div class="lang-switch" aria-label={t(lang, "language")}>
          {
            (Object.keys(languages) as Lang[]).map((code) =>
              code === lang ? (
                <span class="lang-btn active" aria-current="page">
                  {code.toUpperCase()}
                </span>
              ) : (
                <a class="lang-btn" href={otherHref}>
                  {code.toUpperCase()}
                </a>
              ),
            )
          }
        </div>

        <nav class="side-nav" aria-label={t(lang, "navCategories")}>
          <p class="nav-label">{t(lang, "navCategories")}</p>
          <ul>
            {
              categories.map((cat) => (
                <li>
                  <a
                    class:list={[{ active: activeCategory === cat.id }]}
                    href={categoryHref(lang, cat.id)}
                  >
                    <span class="nav-icon" aria-hidden="true">
                      <CategoryIcon id={cat.id} size={17} />
                    </span>
                    <span>{cat.label[lang]}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <nav class="side-footer-nav">
          <a
            class:list={[{ active: activeNav === "home" }]}
            href={langHome(lang)}
          >
            <NavIcon name="home" />
            <span>{t(lang, "navHome")}</span>
          </a>
          <a
            class:list={[{ active: activeNav === "glossary" }]}
            href={glossaryHref(lang)}
          >
            <NavIcon name="glossary" />
            <span>{t(lang, "navGlossary")}</span>
          </a>
          <a
            class:list={[{ active: activeNav === "about" }]}
            href={aboutHref(lang)}
          >
            <NavIcon name="about" />
            <span>{t(lang, "navAbout")}</span>
          </a>
        </nav>
      </aside>

      <div class="content-pane">
        <header class="topbar">
          <p class="eyebrow">{t(lang, "brand")}</p>
          <div class="topbar-actions">
            <a class="ghost-link" href={otherHref}>
              <NavIcon name="language" size={15} />
              <span>{languages[other]}</span>
            </a>
          </div>
        </header>
        <main class="main">
          <slot />
        </main>
        <footer class="page-footer">
          <p>{t(lang, "footer")}</p>
        </footer>
      </div>
    </div>
  </body>
</html>
