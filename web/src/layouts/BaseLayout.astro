---
import BrandMark from "../components/BrandMark.astro";
import CategoryIcon from "../components/CategoryIcon.astro";
import NavIcon from "../components/NavIcon.astro";
import { categories } from "../i18n/categories";
import { t, type Lang } from "../i18n/ui";
import {
  aboutHref,
  categoryHref,
  gameHref,
  glossaryHref,
  langHome,
  systemHref,
  withBase,
} from "../lib/wiki";

interface Props {
  lang: Lang;
  title: string;
  description?: string;
  pathAfterLang?: string;
  activeCategory?: string;
  activeNav?: "home" | "glossary" | "about" | "system" | "game";
}

const {
  lang,
  title,
  description,
  pathAfterLang = "",
  activeCategory,
  activeNav,
} = Astro.props;
---

<!doctype html>
<html lang={lang} data-base={withBase()}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · {t(lang, "brand")}</title>
    {description && <meta name="description" content={description} />}
    <link rel="stylesheet" href={withBase("styles/global.css")} />
    <script src={withBase("scripts/glossary-tooltips.js")} defer></script>
  </head>
  <body>
    <div class="shell">
      <aside class="sidebar">
        <a class="brand" href={langHome(lang)}>
          <BrandMark />
          <span class="brand-text">
            <strong>{t(lang, "brand")}</strong>
            <small>{t(lang, "tagline")}</small>
          </span>
        </a>

        <nav class="side-nav" aria-label={t(lang, "navCategories")}>
          <p class="nav-label">{t(lang, "navCategories")}</p>
          <ul>
            {
              categories.map((cat) => (
                <li>
                  <a
                    class:list={[{ active: activeCategory === cat.id }]}
                    href={categoryHref(lang, cat.id)}
                  >
                    <span class="nav-icon" aria-hidden="true">
                      <CategoryIcon id={cat.id} size={17} />
                    </span>
                    <span>{cat.label[lang]}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <nav class="side-footer-nav">
          <a href={withBase(`${lang}/search`)}>
            <NavIcon name="search" />
            <span>{t(lang, "navSearch")}</span>
          </a>
          <a
            class:list={[{ active: activeNav === "home" }]}
            href={langHome(lang)}
          >
            <NavIcon name="home" />
            <span>{t(lang, "navHome")}</span>
          </a>
          <a
            class:list={[{ active: activeNav === "glossary" }]}
            href={glossaryHref(lang)}
          >
            <NavIcon name="glossary" />
            <span>{t(lang, "navGlossary")}</span>
          </a>
          <a
            class:list={[{ active: activeNav === "about" }]}
            href={aboutHref(lang)}
          >
            <NavIcon name="about" />
            <span>{t(lang, "navAbout")}</span>
          </a>
          <a
            class:list={[{ active: activeNav === "system" }]}
            href={systemHref(lang)}
          >
            <NavIcon name="system" />
            <span>{t(lang, "navSystem")}</span>
          </a>
          <a
            class:list={[{ active: activeNav === "game" }]}
            href={gameHref(lang)}
          >
            <NavIcon name="game" />
            <span>{t(lang, "navGame")}</span>
          </a>
          <a href={withBase(`${lang}/pregens`)}>
            <NavIcon name="game" />
            <span>Готовые персонажи</span>
          </a>
        </nav>
      </aside>

      <div class="content-pane">
        <header class="topbar">
          <p class="eyebrow">{t(lang, "brand")}</p>
          <div class="topbar-actions">
            <form class="quick-search" action={withBase(`${lang}/search`)} method="get">
              <input name="q" type="search" aria-label={t(lang, "navSearch")} placeholder={t(lang, "searchPlaceholder")} />
            </form>
          </div>
        </header>
        <main class="main">
          <slot />
        </main>
        <footer class="page-footer">
          <p>{t(lang, "footer")}</p>
        </footer>
      </div>
    </div>
  </body>
</html>
