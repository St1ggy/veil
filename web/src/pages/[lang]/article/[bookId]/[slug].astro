---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import { type Lang } from "../../../../i18n/ui";
import { allSections, articleHref, bookHref, getBooks, relatedSections, renderMarkdown, sectionsOf } from "../../../../lib/books";

export async function getStaticPaths() {
  const books = await getBooks();
  return books.flatMap((book) => sectionsOf(book).map((section) => ({ params: { lang: "ru", bookId: book.data.id, slug: section.slug }, props: { section, books } })));
}

const L = Astro.params.lang as Lang;
const { section, books } = Astro.props;
const related = relatedSections(section, allSections(books));
const siblings = sectionsOf(section.book);
const previous = siblings[section.order - 1];
const next = siblings[section.order + 1];
const html = renderMarkdown(section.markdown);
---

<BaseLayout lang={L} title={section.title} description={section.summary} pathAfterLang={`article/${section.book.data.id}/${section.slug}`} activeCategory="books">
  <header class="page-header article-hero">
    <div class="meta-row"><a href={bookHref(L, section.book.data.id)}>← {section.book.data.title}</a><span>·</span><span>Статья из канонической книги</span></div>
    <h1>{section.title}</h1>
    {section.summary && <p>{section.summary}…</p>}
  </header>
  <article class="prose" set:html={html} />
  {(previous || next) && (
    <nav class="article-pagination" aria-label="Соседние статьи">
      {previous ? <a href={articleHref(L, previous)}>← {previous.title}</a> : <span />}
      {next && <a href={articleHref(L, next)}>{next.title} →</a>}
    </nav>
  )}
  {related.length > 0 && (
    <section class="relations"><h2>Связанные статьи</h2><ul class="related-grid">{related.map((item) => <li><a href={articleHref(L, item)}>{item.title}</a><small>{item.book.data.title}</small></li>)}</ul></section>
  )}
</BaseLayout>
