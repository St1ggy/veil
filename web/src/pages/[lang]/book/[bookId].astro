---
import BaseLayout from '../../../layouts/BaseLayout.astro'
import { t, type Lang } from '../../../i18n/ui'
import { bookAccent, bookHref, bookSummary, getBooks } from '../../../lib/books'
import { categoryHref } from '../../../lib/wiki'
import { render } from 'astro:content'

export async function getStaticPaths() {
  const books = await getBooks()
  return books.map((book) => ({ params: { lang: 'ru', bookId: book.data.id }, props: { book, books } }))
}

const L = Astro.params.lang as Lang
const { book, books } = Astro.props
const { Content, headings } = await render(book)
const toc = headings.filter((heading) => heading.depth >= 2 && heading.depth <= 4)
const links = [...(book.data.previous ?? []), ...(book.data.next ?? []), ...(book.data.related ?? [])]
const related = links.map((id) => books.find((candidate) => candidate.data.id === id)).filter(Boolean)
const bookIndex = books.findIndex((candidate) => candidate.data.id === book.data.id)
const previousBook =
  (book.data.previous ?? []).map((id) => books.find((candidate) => candidate.data.id === id)).find(Boolean) ??
  books[bookIndex - 1]
const nextBook =
  (book.data.next ?? []).map((id) => books.find((candidate) => candidate.data.id === id)).find(Boolean) ??
  books[bookIndex + 1]
---

<BaseLayout
  lang={L}
  title={book.data.title}
  description={bookSummary(book)}
  pathAfterLang={`book/${book.data.id}`}
  activeCategory="books"
  glossaryTooltips
>
  <header class="page-header book-hero">
    <div class="meta-row">
      <a href={categoryHref(L, 'books')}>← К библиотеке</a><span>·</span><span>{toc.length} разделов</span>
    </div>
    <h1>{book.data.title}</h1>
    <p>{bookSummary(book)}</p>
  </header>

  <nav class="book-pagination" aria-label="Соседние книги">
    {
      previousBook ? (
        <a class="book-pagination__previous" href={bookHref(L, previousBook.data.id)}>
          <>
            <span>←</span>
            <small>Предыдущая книга</small>
            <strong>{previousBook.data.title}</strong>
          </>
        </a>
      ) : (
        <span />
      )
    }
    {
      nextBook ? (
        <a class="book-pagination__next" href={bookHref(L, nextBook.data.id)}>
          <>
            <small>Следующая книга</small>
            <strong>{nextBook.data.title}</strong>
            <span>→</span>
          </>
        </a>
      ) : (
        <span />
      )
    }
  </nav>

  {
    toc.length > 0 && (
      <nav class="book-toc" aria-label="Оглавление книги" style={`--book-accent: ${bookAccent(book)}`}>
        <h2>Оглавление</h2>
        <ol>
          {toc.map((heading) => (
            <li class:list={[`book-toc--level-${heading.depth}`]}>
              <a href={`#${heading.slug}`}>{heading.text.replace(/^\d+(?:\.\d+)*\.\s*/, '')}</a>
            </li>
          ))}
        </ol>
      </nav>
    )
  }

  <article class="prose book-prose"><Content /></article>

  {
    related.length > 0 && !/^#{2,4}\s+(?:см\.\s+также|связанные документы)/imu.test(book.body) && (
      <section class="relations">
        <h2>{t(L, 'seeAlso')}</h2>
        <ul>
          {related.map((item) => (
            <li>
              <a href={bookHref(L, item.data.id)}>{item.data.title}</a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</BaseLayout>
