---
import CategoryIcon from "../../../components/CategoryIcon.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { categories, categoryById } from "../../../i18n/categories";
import {
  labelImportance,
  labelStatus,
  labelType,
} from "../../../i18n/labels";
import { t, type Lang } from "../../../i18n/ui";
import {
  entityHref,
  entriesInCategory,
  getWikiEntries,
  displayTitle,
  displaySummary,
} from "../../../lib/wiki";
import { bookGroup, bookHighlights, bookHref, bookSummary, getBooks, sectionsOf } from "../../../lib/books";

export function getStaticPaths() {
  const langs = ["ru"] as const;
  return langs.flatMap((lang) =>
    categories.map((cat) => ({
      params: { lang, category: cat.id },
    })),
  );
}

const L = Astro.params.lang as Lang;
const categoryId = Astro.params.category as string;
const cat = categoryById(categoryId)!;
const entries = entriesInCategory(await getWikiEntries(L), cat.id);
const books = cat.id === "books" && L === "ru" ? await getBooks() : [];
const bookGroups = Array.from(
  books.reduce((groups, entry) => {
      const section = bookGroup(entry);
      const group = groups.get(section) ?? [];
      group.push(entry);
      groups.set(section, group);
      return groups;
    }, new Map<string, typeof books>()),
);
const totalItems = cat.id === "books" ? books.length : entries.length;
---

<BaseLayout
  lang={L}
  title={cat.label[L]}
  description={cat.description[L]}
  pathAfterLang={`category/${cat.id}`}
  activeCategory={cat.id}
>
  <header class="page-header">
    <div class="meta-row">
      <span class="icon-chip icon-chip--header" aria-hidden="true">
        <CategoryIcon id={cat.id} size={22} />
      </span>
      <span>{t(L, "category")}</span>
    </div>
    <h1>{cat.label[L]}</h1>
    <p>{cat.description[L]}</p>
    <div class="meta-row">
      <span>
        {totalItems} {cat.id === "books" ? "книг" : t(L, "articles")}
      </span>
    </div>
  </header>

  {
    totalItems === 0 ? (
      <p class="notice">{t(L, "emptyCategory")}</p>
    ) : cat.id === "books" ? (
      <div class="book-library">
        {bookGroups.map(([section, books]) => (
          <section class="book-shelf">
            <div class="book-shelf__heading">
              <h2>{section}</h2>
              <span>{books.length}</span>
            </div>
            <div class="book-grid">
              {books.map((entry) => (
                <a class="book-card" href={bookHref(L, entry.data.id)}>
                  <span class="book-card__topline">
                    <span class="book-card__number">{String(books.indexOf(entry) + 1).padStart(2, "0")}</span>
                    <span class="book-card__kind">Каноническая книга</span>
                  </span>
                  <strong class="book-card__title">{entry.data.title}</strong>
                  <span class="book-card__summary">{bookSummary(entry)}</span>
                  <span class="book-card__chapters">
                    {bookHighlights(entry).map((title) => <span>{title}</span>)}
                  </span>
                  <span class="book-card__footer"><small>{sectionsOf(entry).length} статей</small><b aria-hidden="true">Открыть →</b></span>
                </a>
              ))}
            </div>
          </section>
        ))}
      </div>
    ) : (
      <ul class="entity-list">
        {entries.map((entry) => (
          <li>
            <a class="title" href={entityHref(L, entry.data.id)}>
              {displayTitle(entry, L)}
            </a>
            <div class="meta-row">
              {entry.data.type && (
                <span>
                  {t(L, "type")}: {labelType(entry.data.type, L)}
                </span>
              )}
              {entry.data.status && (
                <span>
                  {t(L, "status")}: {labelStatus(entry.data.status, L)}
                </span>
              )}
              {entry.data.importance && (
                <span>
                  {t(L, "importance")}: {labelImportance(entry.data.importance, L)}
                </span>
              )}
            </div>
            {displaySummary(entry, L) && (
              <p class="summary">{displaySummary(entry, L)}</p>
            )}
          </li>
        ))}
      </ul>
    )
  }
</BaseLayout>
