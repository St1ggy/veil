---
import CategoryIcon from "../../../components/CategoryIcon.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { categoryForType } from "../../../i18n/categories";
import {
  labelImportance,
  labelStatus,
  labelTag,
  labelType,
  labelRelation,
} from "../../../i18n/labels";
import { t, type Lang } from "../../../i18n/ui";
import {
  categoryHref,
  entityHref,
  getWikiEntries,
  displayTitle,
  displaySummary,
  langHome,
} from "../../../lib/wiki";
import { render } from "astro:content";

export async function getStaticPaths() {
  const langs = ["ru"] as const;
  const paths = [];
  for (const lang of langs) {
    const entries = await getWikiEntries(lang);
    for (const entry of entries) {
      paths.push({
        params: { lang, entityId: entry.data.id },
        props: { entry },
      });
    }
  }
  return paths;
}

const L = Astro.params.lang as Lang;
const { entry } = Astro.props;
const { Content } = await render(entry);
const relations = entry.data.relations ?? [];
const tags = entry.data.tags ?? [];
const cat = categoryForType(entry.data.type);
const allEntries = await getWikiEntries(L);
const entryById = new Map(allEntries.map((item) => [item.data.id, item]));
const explicitTargets = new Set(relations.map((relation) => relation.target));
const automaticRelated = allEntries
  .filter((candidate) => candidate.data.id !== entry.data.id && !explicitTargets.has(candidate.data.id))
  .map((candidate) => ({ candidate, score: (candidate.data.tags ?? []).filter((tag) => tags.includes(tag)).length + (candidate.data.type === entry.data.type ? 0.5 : 0) }))
  .filter(({ score }) => score > 0)
  .sort((a, b) => b.score - a.score)
  .slice(0, 8)
  .map(({ candidate }) => candidate);
---

<BaseLayout
  lang={L}
  title={displayTitle(entry, L)}
  description={displaySummary(entry, L)}
  pathAfterLang={`entity/${entry.data.id}`}
  activeCategory={cat?.id}
  glossaryTooltips
>
  <header class="page-header">
    <div class="meta-row">
      <a href={langHome(L)}>{t(L, "backHome")}</a>
      {
        cat && (
          <>
            <span>·</span>
            <a class="crumb-cat" href={categoryHref(L, cat.id)}>
              <CategoryIcon id={cat.id} size={14} />
              <span>{cat.label[L]}</span>
            </a>
          </>
        )
      }
    </div>
    <h1>{displayTitle(entry, L)}</h1>
    <div class="meta-row">
      {
        entry.data.type && (
          <span>
            {t(L, "type")}: {labelType(entry.data.type, L)}
          </span>
        )
      }
      {
        entry.data.status && (
          <span>
            {t(L, "status")}: {labelStatus(entry.data.status, L)}
          </span>
        )
      }
      {
        entry.data.importance && (
          <span>
            {t(L, "importance")}: {labelImportance(entry.data.importance, L)}
          </span>
        )
      }
    </div>
    {
      tags.length > 0 && (
        <div class="meta-row tags-row">
          <span>{t(L, "tags")}:</span>
          {tags.map((tag) => (
            <span class="badge">{labelTag(tag, L)}</span>
          ))}
        </div>
      )
    }
    {displaySummary(entry, L) && <p>{displaySummary(entry, L)}</p>}
  </header>

  <article class="prose">
    <Content />
  </article>

  {
    relations.length > 0 && (
      <section class="relations">
        <h2>{t(L, "relations")}</h2>
        <ul class="related-grid">
          {relations.map((rel) => {
            const target = entryById.get(rel.target);
            return target ? <li><small>{labelRelation(rel.type, L)}</small><a href={entityHref(L, rel.target)}>{target.data.title}</a></li> : null;
          })}
        </ul>
      </section>
    )
  }
  {automaticRelated.length > 0 && (
    <section class="relations">
      <h2>{t(L, "seeAlso")}</h2>
      <ul class="related-grid">{automaticRelated.map((item) => <li><a href={entityHref(L, item.data.id)}>{item.data.title}</a></li>)}</ul>
    </section>
  )}
</BaseLayout>
