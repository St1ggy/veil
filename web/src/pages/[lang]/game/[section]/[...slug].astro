---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import {
  gameSectionById,
  type GameSectionId,
} from "../../../../i18n/gameSections";
import { labelStatus, labelType } from "../../../../i18n/labels";
import { t, type Lang } from "../../../../i18n/ui";
import {
  DETAIL_KEYS,
  loadGameCatalog,
  type GameItem,
} from "../../../../lib/gameCatalog";
import {
  formatFieldValue,
  renderGameMarkdown,
} from "../../../../lib/gameMarkdown";
import {
  entityHref,
  gameHref,
  gameSectionHref,
} from "../../../../lib/wiki";

export function getStaticPaths() {
  const langs = ["ru", "en"] as const;
  const items = loadGameCatalog();
  const paths: {
    params: { lang: string; section: string; slug: string };
    props: { item: GameItem };
  }[] = [];

  for (const lang of langs) {
    for (const item of items) {
      paths.push({
        params: {
          lang,
          section: item.sectionId,
          slug: item.slug,
        },
        props: { item },
      });
    }
  }
  return paths;
}

const L = Astro.params.lang as Lang;
const sectionId = Astro.params.section as GameSectionId;
const { item } = Astro.props as { item: GameItem };
const section = gameSectionById(sectionId)!;

const bodyHtml = item.bodyMd
  ? renderGameMarkdown(item.bodyMd, (id) => entityHref(L, id))
  : "";

const loreTargets = Array.isArray(item.data.lore_targets)
  ? item.data.lore_targets.filter((x): x is string => typeof x === "string")
  : [];

const relations = Array.isArray(item.data.relations)
  ? (item.data.relations as { type?: string; target?: string }[])
  : [];

const detailEntries = DETAIL_KEYS.filter((key) => {
  if (key === "purpose" || key === "scope") {
    // Often duplicated in body headings
    return item.data[key] != null && !item.bodyMd;
  }
  const v = item.data[key];
  if (v == null) return false;
  if (Array.isArray(v) && v.length === 0) return false;
  if (typeof v === "string" && !v.trim()) return false;
  return true;
});
---

<BaseLayout
  lang={L}
  title={item.title}
  description={item.summary}
  pathAfterLang={`game/${sectionId}/${item.slug}`}
  activeNav="game"
>
  <article class="prose game-item">
    <header class="page-header">
      <div class="meta-row">
        <a href={gameHref(L)}>{t(L, "gameBack")}</a>
        <span>·</span>
        <a href={gameSectionHref(L, sectionId)}>{section.label[L]}</a>
      </div>
      <h1>{item.title}</h1>
      <div class="meta-row">
        {item.id && <span class="badge">{item.id}</span>}
        {
          item.type && (
            <span>
              {t(L, "type")}: {labelType(item.type, L)}
            </span>
          )
        }
        {
          item.status && (
            <span>
              {t(L, "status")}: {labelStatus(item.status, L)}
            </span>
          )
        }
      </div>
      {item.summary && <p>{item.summary}</p>}
    </header>

    {
      detailEntries.length > 0 && (
        <section>
          <h2>{t(L, "gameNotes")}</h2>
          <dl class="system-dl">
            {detailEntries.map((key) => {
              const raw = formatFieldValue(item.data[key]);
              const html = renderGameMarkdown(raw, (id) => entityHref(L, id));
              return (
                <>
                  <dt>{key}</dt>
                  <dd set:html={html} />
                </>
              );
            })}
          </dl>
        </section>
      )
    }

    {bodyHtml && <div class="game-body" set:html={bodyHtml} />}

    {
      (loreTargets.length > 0 || relations.length > 0) && (
        <section>
          <h2>{t(L, "gameRelatedLore")}</h2>
          <ul>
            {loreTargets.map((id) => (
              <li>
                <a href={entityHref(L, id)}>{id}</a>
              </li>
            ))}
            {relations
              .filter((r) => r.target)
              .map((r) => (
                <li>
                  {r.type && <span class="muted">{r.type}: </span>}
                  <a href={entityHref(L, r.target!)}>{r.target}</a>
                </li>
              ))}
          </ul>
        </section>
      )
    }

    <p class="meta-row muted">
      <span>
        {t(L, "gameSource")}: <code>{item.sourcePath}</code>
      </span>
    </p>
  </article>
</BaseLayout>
