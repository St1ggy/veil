---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { t, type Lang } from "../../i18n/ui";
import { publishedGlossary } from "../../lib/glossary";

export function getStaticPaths() {
  return [{ params: { lang: "ru" } }];
}

const L = Astro.params.lang as Lang;
const terms = await publishedGlossary(L);
---

<BaseLayout
  lang={L}
  title={t(L, "glossaryTitle")}
  description={t(L, "glossaryIntro")}
  pathAfterLang="glossary"
  activeNav="glossary"
>
  <header class="page-header">
    <h1>{t(L, "glossaryTitle")}</h1>
    <p>{t(L, "glossaryIntro")}</p>
    <div class="meta-row">
      <span>{terms.length} {t(L, "articles")}</span>
    </div>
  </header>

  <div class="glossary-wrap">
    <table class="glossary-table">
      <thead>
        <tr>
          <th>{t(L, "glossaryTerm")}</th>
          <th>{t(L, "glossaryId")}</th>
          <th>{t(L, "glossaryDefinition")}</th>
        </tr>
      </thead>
      <tbody>
        {
          terms.map((term) => (
            <tr>
              <td>
                <a class="glossary-term" href={term.href}>
                  {term.name}
                </a>
              </td>
              <td>
                <a class="badge" href={term.href}>
                  {term.source}
                </a>
              </td>
              <td>{term.definition}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</BaseLayout>
