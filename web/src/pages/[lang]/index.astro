---
import CategoryIcon from '../../components/CategoryIcon.astro'
import NavIcon from '../../components/NavIcon.astro'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { categories } from '../../i18n/categories'
import { labelType } from '../../i18n/labels'
import { countLabel } from '../../i18n/ru'
import { t, type Lang } from '../../i18n/ui'
import { getBooks } from '../../lib/books'
import { parseAscended, parsePregens } from '../../lib/characters'
import {
  categoryHref,
  entityHref,
  entriesInCategory,
  featuredIds,
  getWikiEntries,
  glossaryHref,
  systemHref,
  gameHref,
  displayTitle,
  displaySummary,
} from '../../lib/wiki'

export function getStaticPaths() {
  return [{ params: { lang: 'ru' } }]
}

const L = Astro.params.lang as Lang
const entries = await getWikiEntries(L)
const books = await getBooks()
const pregensBook = books.find((item) => item.data.id === 'game.appendix.pregenerated_characters')
const ascendedBook = books.find((item) => item.data.id === 'game.appendix.ascended_registry')
const specialCounts: Record<string, number> = {
  books: books.length,
  pregens: pregensBook ? (await parsePregens(pregensBook, new Map())).length : 0,
  ascended: ascendedBook ? (await parseAscended(ascendedBook, new Map())).length : 0,
  worldview: 1,
}
const featured = featuredIds.map((id) => entries.find((e) => e.data.id === id)).filter(Boolean)
---

<BaseLayout lang={L} title={t(L, 'navHome')} description={t(L, 'tagline')} pathAfterLang="">
  <section class="hero">
    <h1>{t(L, 'heroTitle')}</h1>
    <p>{t(L, 'heroBody')}</p>
    <div class="hero-actions">
      <a class="btn btn-primary" href={categoryHref(L, 'cosmology')}>
        <CategoryIcon id="cosmology" size={16} />
        <span>{t(L, 'explore')}</span>
      </a>
      <a class="btn btn-secondary" href={systemHref(L)}>
        <NavIcon name="system" size={16} />
        <span>{t(L, 'navSystem')}</span>
      </a>
      <a class="btn btn-secondary" href={gameHref(L)}>
        <NavIcon name="game" size={16} />
        <span>{t(L, 'navGame')}</span>
      </a>
      <a class="btn btn-secondary" href={glossaryHref(L)}>
        <NavIcon name="glossary" size={16} />
        <span>{t(L, 'navGlossary')}</span>
      </a>
    </div>
  </section>

  <h2 class="section-title">{t(L, 'structure')}</h2>
  <div class="category-grid">
    {
      categories.map((cat) => {
        const count = specialCounts[cat.id] ?? entriesInCategory(entries, cat.id).length
        const countText =
          cat.id === 'books'
            ? countLabel(count, ['книга', 'книги', 'книг'])
            : cat.id === 'pregens'
              ? countLabel(count, ['персонаж', 'персонажа', 'персонажей'])
              : cat.id === 'ascended'
                ? countLabel(count, ['личность', 'личности', 'личностей'])
                : countLabel(count, ['статья', 'статьи', 'статей'])
        return (
          <a class="category-card" href={categoryHref(L, cat.id)}>
            <span class="icon-chip" aria-hidden="true">
              <CategoryIcon id={cat.id} size={20} />
            </span>
            <h2>{cat.label[L]}</h2>
            <p>{cat.description[L]}</p>
            <span class="count">{countText}</span>
          </a>
        )
      })
    }
  </div>

  <h2 class="section-title">{t(L, 'featured')}</h2>
  <ul class="entity-list">
    {
      featured.map((entry) =>
        entry ? (
          <li>
            <a class="title" href={entityHref(L, entry.data.id)}>
              {displayTitle(entry, L)}
            </a>
            <div class="meta-row">{entry.data.type && <span>{labelType(entry.data.type, L)}</span>}</div>
            {displaySummary(entry, L) && <p class="summary">{displaySummary(entry, L)}</p>}
          </li>
        ) : null,
      )
    }
  </ul>
</BaseLayout>
