---
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBase } from "../lib/wiki";
---

<BaseLayout title="О проекте">
  <article class="prose">
    <h1>О проекте</h1>
    <p>
      <strong>Veil of Worlds</strong> — knowledge base оригинального TTRPG-сеттинга:
      альтернативная Земля 2435 после ослабления Вуали.
    </p>
    <h2>Слои репозитория</h2>
    <ul>
      <li><code>data/</code> — структурированные факты (YAML)</li>
      <li><code>wiki/</code> — энциклопедическая проза (Markdown)</li>
      <li><code>books/</code> — Typst PDF</li>
      <li><code>web/</code> — этот сайт на Astro</li>
    </ul>
    <h2>Сборка</h2>
    <pre><code>cd web && npm install && npm run build
# или из корня:
make site</code></pre>
    <p><a href={withBase()}>К энциклопедии</a></p>
  </article>
</BaseLayout>
